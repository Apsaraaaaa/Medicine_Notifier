{
  "expo": {
    "name": "Medicine Notifier",
    "slug": "medicine-notifier",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "medicinenotifier",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "android",
      "web"
    ],
    "web": {
      "output": "single",
      "bundler": "metro"
    },
    "android": {
      "package": "com.medicinenotifier.app",
      "adaptiveIcon": {
        "backgroundColor": "#7B61D9",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.VIBRATE",
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#6C4FD0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7B61D9",
          "defaultChannel": "medicine-reminders"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Medicine Notifier reads a photo of your medicine box or prescription so it can fill in the form for you.",
          "cameraPermission": "Medicine Notifier uses the camera to read your medicine box or prescription and fill in the form for you."
        }
      ],
      "expo-audio",
      "expo-font",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
