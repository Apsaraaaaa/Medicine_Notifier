# Base URL of the Django REST API. Copy to `mobile/.env` to override.
#
# Leave it unset and the app picks a sensible default:
#   physical phone via Expo   -> the LAN address Metro is served from, port 8000
#   Android emulator          -> http://10.0.2.2:8000/api
#
# EXPO_PUBLIC_* is the only prefix Expo exposes to app code, and the value is
# inlined at build time, so restart the dev server after changing it.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8000/api
