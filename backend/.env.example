# ---------------------------------------------------------------------------
# Medicine Notifier — backend environment
# Copy to `.env` and fill in real values. Never commit `.env`.
#
# Generate a fresh SECRET_KEY with:
#   venv\Scripts\python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# ---------------------------------------------------------------------------

SECRET_KEY=replace-me-with-a-50-character-random-string
DEBUG=True

# Comma-separated. Leave blank to allow any host while DEBUG=True (handy for
# the Android emulator and a phone on your LAN).
ALLOWED_HOSTS=

# --- Database (PostgreSQL) --------------------------------------------------
# `venv\Scripts\python scripts\create_db.py` creates the database and this
# user, then writes the generated password back into .env.
DB_NAME=medicine_notifier
DB_USER=medicine_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Seconds to keep a database connection open between requests (0 = close each time).
DB_CONN_MAX_AGE=60

# --- Auth -------------------------------------------------------------------
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# --- Misc -------------------------------------------------------------------
TIME_ZONE=UTC
